# ===== CẤU HÌNH BRIDGE THIỀN ĐƯỜNG TỊNH TÂM =====
# Sao chép file này thành ".env" rồi điền giá trị thật:  cp .env.example .env
# TUYỆT ĐỐI không chia sẻ file .env đã điền key cho người khác.

# Username TikTok của kênh sẽ live (KHÔNG cần dấu @, không dán cả link).
# Bridge sẽ bắt comment/gift từ kênh đang LIVE này.
# Ví dụ: nếu kênh là tiktok.com/@abc123/live thì điền: abc123
TIKTOK_USERNAME=

# (Không bắt buộc) API key của EulerStream — dịch vụ ký WebSocket cho TikTok.
# Có key thì kết nối ổn định hơn, đỡ bị giới hạn tần suất ký.
# Không có key: bridge vẫn chạy ở chế độ mặc định của thư viện (ký qua máy chủ
# công cộng của EulerStream, có thể bị rate-limit khi đông người dùng chung).
# Cách lấy key miễn phí: xem HUONG-DAN.md mục 7(b).
EULER_API_KEY=

# Cổng mở trang web trên máy này (mặc định 8080).
# Mở trình duyệt tới http://localhost:8080 để xem thiền đường.
PORT=8080

# ===== ĐỢT 21: GIỌNG ĐỌC TÊN + LỜI KHẤN (TTS local) — không cần điền vào .env =====
# Bridge tự chạy worker bridge/tts_worker.py ở yêu cầu /tts đầu tiên.
# Python dùng cho worker: ưu tiên bridge/tts-venv/bin/python nếu có, không thì
# python3. Chỉ định khác bằng biến môi trường TDTT_TTS_PYTHON khi chạy bridge.
# Tắt hẳn giọng đọc phía server: chạy bridge với TDTT_TTS=off.
# Model Piper dự phòng nằm ở bridge/tts-models/ (hoặc trỏ TDTT_PIPER_MODEL).
