# Sao chép file này thành ".env" rồi điền giá trị thật (KHÔNG gửi token qua chat).
# Cách lấy từng giá trị: xem HUONG-DAN.md mục 2.

# ID của Trang Facebook sẽ phát live Thiền Đường (số, lấy ở mục "Giới thiệu" của Trang
# hoặc trong URL Meta Business Suite).
FB_PAGE_ID=

# Page Access Token (token dài hạn của Trang, lấy qua Graph API Explorer —
# xem HUONG-DAN.md). Token này chỉ để ĐỌC bình luận live; không đăng gì thay Trang.
FB_PAGE_ACCESS_TOKEN=

# Phiên bản Graph API (để mặc định nếu không có lý do đổi).
FB_GRAPH_VERSION=v21.0

# Cổng chạy bridge Facebook (mặc định 8090 — để trống là dùng 8090).
# Để 8090 để chạy SONG SONG với bridge TikTok ở 8080 (giọng đọc /tts
# được uỷ quyền sang cổng 8080).
FB_PORT=8090

# Chu kỳ polling dự phòng khi luồng streaming lỗi (mili-giây, tối thiểu 1500).
FB_POLL_MS=2500

# Nơi uỷ quyền giọng đọc /tts (bridge TikTok). Nếu không chạy bridge TikTok
# thì bỏ qua — trang tự rơi xuống giọng trình duyệt.
TTS_PROXY=http://127.0.0.1:8080
